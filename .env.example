PYTHONPATH=.

#============================
# LLM Provider Settings
#============================
# Existing models use LiteLLM. OpenAI GPT-6 models use the Responses API.
# Full list of supported providers: https://docs.litellm.ai/docs/providers
# LLM_MODEL is the default for every role unless a role override is set.
# Examples:

# OpenAI
# LLM_MODEL="openai/<model_of_choice>"
# OPENAI_API_KEY=<your_openai_api_key>
LLM_MODEL=openai/gpt-6-sol
OPENAI_API_KEY=
# Optional per-role overrides; blank values inherit LLM_MODEL.
LLM_INTENT_MODEL=
LLM_EXTRACTION_MODEL=
LLM_REFLECTION_MODEL=
# GPT-6 OpenAI models use the Responses API. Start at low effort; tune with evals.
LLM_REASONING_EFFORT=low

# Azure OpenAI
# LLM_MODEL="azure/<your_deployment_name>"
# AZURE_API_BASE=https://your-azure-resource.openai.azure.com/
# AZURE_API_KEY=<your_azure_api_key>
# AZURE_API_VERSION=<your_azure_api_version>

# GROQ
# LLM_MODEL="groq/<model_of_choice>"
# GROQ_API_KEY=<your_groq_api_key>

# Litellm Proxy
# LLM_MODEL="azure/<your_deployment_name>"
# LITELLM_PROXY_BASE_URL=<your_litellm_proxy_base_url>
# LITELLM_PROXY_API_KEY=<your_litellm_proxy_api_key>

# NVIDIA NIM
# LLM_MODEL="nvidia_nim/<model_of_choice>"
# NVIDIA_NIM_API_KEY=<your_nvidia_api_key>
# NVIDIA_NIM_API_BASE=<your_nvidia_nim_endpoint_url>

#============================
# SerpAPI Settings (Travel Agent)
#============================
# SerpAPI is used to search for flights and hotels
# Get your API key at: https://serpapi.com/
SERPAPI_API_KEY=

# Minimum hours between flight arrival and hotel check-in
# Accounts for: customs, baggage, airport-to-hotel travel
# Default: 2 hours
TRAVEL_HOTEL_CHECKIN_GAP_HOURS=2

#============================
# Identity Auth Settings
#============================
# Set these variables to enable Agntcy Identity Auth (TBAC).
IDENTITY_AUTH_ENABLED="false"
IDENTITY_SERVICE_API_KEY_TRAVEL_SUPERVISOR=xxx

#============================
# Local Development Settings
#============================
# (not needed when running Docker Compose)

# OTEL environment variables
# OTLP_HTTP_ENDPOINT="http://localhost:4318"
TRACING_ENABLED=false

# === Transport Settings ===
# NATS (Default):
# DEFAULT_MESSAGE_TRANSPORT=NATS
# TRANSPORT_SERVER_ENDPOINT=nats://localhost:4222
# Compose uses its own override so local localhost settings cannot break containers:
# DOCKER_TRANSPORT_SERVER_ENDPOINT=nats://nats:4222

# === Agntcy TBAC Settings (Local) ===
# For local development, set IDENTITY_AUTH_ENABLED to true to enable Agntcy Identity Auth (TBAC).
# IDENTITY_AUTH_ENABLED="true"
# IDENTITY_SERVICE_API_KEY=<your_api_key>
