FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /uvx /bin/
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app HOTEL_AGENT_HOST=0.0.0.0
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project
COPY . .
RUN uv sync --locked
CMD ["uv", "run", "--no-sync", "python", "-m", "agents.hotel.server"]
